table 'congress_silver bills'
	lineageTag: aeb5f88e-ff42-4dac-9587-a65fb2dc1f06

	measure '# Bills' = count('congress_silver bills'[Bill])
		formatString: #,0
		lineageTag: 7eeb63d2-7c5d-4a30-8354-27bd5457ee30

	measure 'Selection Message' =
			
			IF(
			    HASONEVALUE('congress_silver bills'[Bill]),
			    "DETAILS",
			    "PLEASE SELECT ONE BILL ON LEFT SIDE TO SEE DETAILS BELOW"
			)
		lineageTag: 5051d253-9d9f-41b3-8348-477d051450e6

	measure 'Show Details' =
			
			IF(
			    COUNTROWS(ALLSELECTED('congress_silver bills'[Bill])) = 1,
			    1,
			    0
			)
		formatString: 0
		lineageTag: b6aa1530-7392-4f8a-981f-97ad0f1c1d21

